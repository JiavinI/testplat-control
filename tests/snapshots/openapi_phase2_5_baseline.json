            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Project",
        "tags": [
          "projects"
        ]
      },
      "get": {
        "description": "获取项目详情\n\nArgs:\n    project_id: 项目ID\n    db: 数据库会话\n\nReturns:\n    ProjectResponse: 项目信息\n\nRaises:\n    HTTPException: 项目不存在时返回 404",
